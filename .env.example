# ===== ВКонтакте =====
# Токен сообщества: Управление -> Настройки -> Работа с API -> Ключи доступа
# Нужны права: "сообщения сообщества"
VK_GROUP_TOKEN=vk1.a.xxxxxxxxxxxx

# ID сообщества (число, без минуса). Можно не указывать — бот определит сам.
VK_GROUP_ID=

# ===== Timeweb Cloud AI =====
# Создайте AI-агента в панели Timeweb Cloud (раздел "AI-агенты"),
# выберите модель GPT-5.4. ID агента и API-ключ — на вкладке "Дашборд" агента.
TIMEWEB_AGENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TIMEWEB_AGENT_TOKEN=xxxxxxxxxxxx

# Название модели отправляется только для совместимости —
# реально используется модель, выбранная в настройках агента.
AI_MODEL=gpt-5.4
# 0.7-0.8 — более сдержанные, предсказуемые ответы;
# 0.9-1.0 — живее и разнообразнее (рекомендуется для чата);
# 1.1+ — риск бессвязных ответов.
AI_TEMPERATURE=0.9
AI_MAX_TOKENS=600

# ===== Поведение бота =====
# Системный промпт (характер бота). Если пусто — используется встроенный.
SYSTEM_PROMPT=

# Имена, на которые бот откликается в беседе (через запятую)
BOT_NAMES=винхайлин,виня,vinhailyn

# Вероятность (0..1), что бот сам влезет в разговор без обращения к нему
RANDOM_REPLY_CHANCE=0.05

# Сколько последних сообщений беседы помнит бот
HISTORY_SIZE=30

# Файл для сохранения истории между перезапусками контейнера.
# В docker-compose.yml примонтирован том ./data — менять не обязательно.
HISTORY_FILE=/app/data/history.json

# Через сколько минут тишины в беседе бот сам напишет первым (0 — выключить)
IDLE_NUDGE_MINUTES=180

# Писать первым только в беседах, не в личных сообщениях сообщества
IDLE_NUDGE_CHATS_ONLY=true

# ===== Диагностика (временно, для отладки) =====
# Число из адреса vk.com/im?sel=c<число> — точечно проверяет доступ бота
# к конкретной беседе при старте, даже если она не видна через обычный
# список диалогов (типично для уровня доступа «только упоминания»).
DEBUG_CHAT_LOCAL_ID=
