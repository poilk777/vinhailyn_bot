# ===== ВКонтакте =====
# Токен сообщества: Управление -> Настройки -> Работа с API -> Ключи доступа
# Нужны права: "сообщения сообщества"
VK_GROUP_TOKEN=vk1.a.xxxxxxxxxxxx

# ID сообщества (число, без минуса). Можно не указывать — бот определит сам.
VK_GROUP_ID=

# ===== Timeweb Cloud AI =====
# Создайте AI-агента в панели Timeweb Cloud (раздел "AI-агенты"),
# выберите модель GPT-5.4. ID агента и API-ключ — на вкладке "Дашборд" агента.
TIMEWEB_AGENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TIMEWEB_AGENT_TOKEN=xxxxxxxxxxxx

# Название модели отправляется только для совместимости —
# реально используется модель, выбранная в настройках агента.
AI_MODEL=gpt-5.4
AI_TEMPERATURE=1.0
AI_MAX_TOKENS=600

# ===== Поведение бота =====
# Системный промпт (характер бота). Если пусто — используется встроенный.
SYSTEM_PROMPT=

# Имена, на которые бот откликается в беседе (через запятую)
BOT_NAMES=винхайлин,виня,vinhailyn

# Вероятность (0..1), что бот сам влезет в разговор без обращения к нему
RANDOM_REPLY_CHANCE=0.05

# Сколько последних сообщений беседы помнит бот
HISTORY_SIZE=30
